{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oss-pr-radar/war-room-projection.v1.schema.json",
  "title": "Managed War Room user projection",
  "type": "object",
  "required": ["schema", "schemaVersion", "artifactType", "source", "observedAt", "buckets", "items", "artifactDigest"],
  "properties": {
    "schema": {"const": "oss-pr-radar.war-room-projection.v1"},
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "managed_user_projection"},
    "source": {"type": "object", "required": ["ledgerSchemaVersion", "sourceCommit"], "additionalProperties": false},
    "observedAt": {"type": "string"},
    "buckets": {
      "type": "object",
      "required": ["DECISION_REQUIRED", "SYSTEM_PROCESSING", "WAITING_EXTERNAL", "PORTFOLIO_READY"],
      "properties": {
        "DECISION_REQUIRED": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "SYSTEM_PROCESSING": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "WAITING_EXTERNAL": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "PORTFOLIO_READY": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      },
      "additionalProperties": false
    },
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "artifactDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["candidateKey", "bucket", "title", "reason", "evidenceLevel", "nextAction", "actionable", "reviewRequired", "actionKind", "notificationDigest", "notificationStatus", "notified", "creationGatePassed", "taskId", "originKind", "originPrUrl"],
      "properties": {
        "candidateKey": {"type": "string", "minLength": 1},
        "bucket": {"enum": ["DECISION_REQUIRED", "SYSTEM_PROCESSING", "WAITING_EXTERNAL", "PORTFOLIO_READY"]},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidenceLevel": {"enum": ["待补充", "有记录", "已核实", "外部记录"]},
        "nextAction": {"type": "string", "minLength": 1},
        "actionable": {"type": "boolean"},
        "reviewRequired": {"type": "boolean"},
        "actionKind": {"enum": ["NONE", "MANAGED_TASK", "USER_DECISION"]},
        "notificationDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "notificationStatus": {"enum": ["NONE", "PENDING", "SENT", "FAILED", "RECONCILE_REQUIRED"]},
        "notified": {"type": "boolean"},
        "creationGatePassed": {"type": "boolean"},
        "taskId": {"type": ["string", "null"]},
        "originKind": {"type": "string"},
        "originPrUrl": {"type": ["string", "null"]}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "actionable": {"const": false},
            "reviewRequired": {"const": false},
            "actionKind": {"const": "NONE"},
            "notificationDigest": {"type": "null"},
            "notificationStatus": {"const": "NONE"},
            "notified": {"const": false},
            "creationGatePassed": {"const": false}
          }
        },
        {
          "properties": {
            "actionable": {"const": true},
            "reviewRequired": {"const": false},
            "actionKind": {"const": "MANAGED_TASK"},
            "notificationDigest": {"type": "null"},
            "notificationStatus": {"const": "NONE"},
            "notified": {"const": false},
            "creationGatePassed": {"const": true},
            "taskId": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "bucket": {"const": "DECISION_REQUIRED"},
            "actionable": {"const": false},
            "reviewRequired": {"const": true},
            "actionKind": {"const": "USER_DECISION"},
            "notificationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "notificationStatus": {"enum": ["PENDING", "SENT", "FAILED", "RECONCILE_REQUIRED"]},
            "creationGatePassed": {"const": false},
            "taskId": {"type": "null"}
          }
        }
      ]
    }
  }
}
